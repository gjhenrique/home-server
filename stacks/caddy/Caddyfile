{
	order authenticate before respond
	order authorize before basicauth

	security {
		oauth identity provider google {
			realm google
			driver google
			client_id {$GOOGLE_CLIENT_ID}.apps.googleusercontent.com
			client_secret {$GOOGLE_CLIENT_SECRET}
			scopes openid email profile
		}

		authentication portal myportal {
			crypto default token lifetime 3600
			crypto key sign-verify {$JWT_SHARED_KEY}
			enable identity provider google
			cookie domain {$DOMAIN}
			ui {
				links {
					"My Identity" "/whoami" icon "las la-user"
				}
			}

			transform user {
				match realm google
				regex match email {$ALLOWED_EMAILS}
				action add role authp/user
			}

			# PMQ apps use a dedicated role so PMQ access can stay narrower than
			# the general authp/user group. Fail closed via the compose default.
			transform user {
				match realm google
				regex match email {$PMQ_ALLOWED_EMAILS}
				action add role pmq/app-user
			}
		}

		authorization policy mypolicy {
			set auth url https://auth.{$DOMAIN}/oauth2/google
			crypto key verify {$JWT_SHARED_KEY}
			allow roles authp/admin authp/user
			validate bearer header
			inject headers with claims
		}

		# PMQ apps: dedicated role plus the identity header PMQ trusts from its
		# Caddy peer. The policy clears a client-supplied X-PMQ-User before
		# authorization and injects it only for a valid token.
		authorization policy pmq_apps {
			set auth url https://auth.{$DOMAIN}/oauth2/google
			crypto key verify {$JWT_SHARED_KEY}
			allow roles pmq/app-user
			inject header "X-PMQ-User" from email
		}

		# Paperless: allow username/password login (web + API). No Caddy JWT required.
		authorization policy paperless_policy {
			bypass uri prefix /
			set auth url https://auth.{$DOMAIN}/oauth2/google
			crypto key verify {$JWT_SHARED_KEY}
			allow roles authp/admin authp/user
			validate bearer header
			inject headers with claims
		}
	}
}

(only_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}

(sso) {
	import only_tls
	authorize with mypolicy
}

# PMQ apps: every request on the app wildcard is authorized against the
# shared Google SSO portal before it reaches PMQ; admin routes are blocked.
*.quick.{$DOMAIN} {
	import only_tls
	route {
		@admin path /_pmq/admin /_pmq/admin/*
		respond @admin "Not Found" 404

		# Defense in depth; the pmq_apps policy also clears this header.
		request_header -X-PMQ-User
		authorize with pmq_apps
		reverse_proxy 127.0.0.1:8080
	}
}

# PMQ operator hostname: private CIDRs only, admin API only. PMQ still
# requires its bearer deploy token; SSO alone grants no admin access.
pmq-admin.quick.{$DOMAIN} {
	import only_tls
	route {
		@notAdmin not path /_pmq/admin /_pmq/admin/*
		respond @notAdmin "Not Found" 404
		@operator remote_ip {$PMQ_OPERATOR_CIDRS}
		request_header -X-PMQ-User
		reverse_proxy @operator 127.0.0.1:8080
		respond "Forbidden" 403
	}
}

auth.{$DOMAIN} {
	import only_tls
	authenticate with myportal
}
